// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id           String      @id @default(cuid())
  sube         String
  siparisTarihi String
  teslimTarihi  String
  pageMode     String      @default("auto") // "auto" | "fit1" | "splitN"
  splitCount   Int         @default(1)
  scale        Int         @default(100) // yüzde ölçek (görsel küçültme)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  position  Int // genel sıralama (0'dan başlar), listedeki gerçek konum
  malzemeAdi String  @default("")
  miktar     String  @default("")
  stokDurumu String  @default("")

  @@index([orderId, position])
}
